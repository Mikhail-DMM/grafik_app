# Пример файла окружения.
# Скопируй его в .env и заполни значения локально: cp .env.example .env
# Файл .env НЕ коммитится (правило .env в .gitignore).
#
# Приложение полностью клиентское и работает без этих переменных —
# они заведены на будущее (бэкенд, аналитика).
# Vite прокидывает в браузер ТОЛЬКО переменные с префиксом VITE_.

# Базовый URL API, если появится серверная часть
VITE_API_URL=

# Идентификатор аналитики, если подключишь метрики
VITE_ANALYTICS_ID=
